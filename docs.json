{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "BreachLens",
  "description": "Self-hosted DevSecOps — 9 scanner tiers, multi-AI auto-fix, cross-tier attack-path correlation, air-gappable for federal.",
  "colors": {
    "primary": "#1D4ED8",
    "light": "#3B82F6",
    "dark": "#1E40AF"
  },
  "appearance": {
    "default": "system",
    "strict": false
  },
  "fonts": {
    "heading": { "family": "Geist", "weight": 600, "source": "/fonts/geist-latin-600-normal.woff2", "format": "woff2" },
    "body": { "family": "Geist", "weight": 400, "source": "/fonts/geist-latin-400-normal.woff2", "format": "woff2" }
  },
  "favicon": "/favicon.svg",
  "redirects": [
    { "source": "/deployment/airgap", "destination": "/deployment/self-hosting#air-gapped-install" },
    { "source": "/security/license", "destination": "/deployment/self-hosting#licensing" },
    { "source": "/auth/sso", "destination": "/auth" },
    { "source": "/ai/providers", "destination": "/ai-providers" }
  ],
  "navigation": {
    "pages": [
      {
        "group": "Getting started",
        "pages": [
          "index",
          "quickstart"
        ]
      },
      {
        "group": "Deployment",
        "pages": [
          "deployment/self-hosting"
        ]
      },
      {
        "group": "Platform",
        "pages": [
          "auth",
          "ai-providers"
        ]
      },
      {
        "group": "Scanning",
        "pages": [
          "scanning/repositories",
          "scanning/github-posture",
          "scanning/cloud",
          "scanning/containers",
          "scanning/domains",
          "scanning/authenticated-scans",
          "scanning/kubernetes"
        ]
      },
      {
        "group": "AI & identity",
        "pages": [
          "ai-identity/identities",
          "ai-identity/ai-agents",
          "ai-identity/mcp-servers"
        ]
      },
      {
        "group": "Pipeline & monitoring",
        "pages": [
          "pipeline/cicd",
          "pipeline/continuous-monitoring",
          "pipeline/runtime"
        ]
      },
      {
        "group": "IDE",
        "pages": [
          "ide/vscode"
        ]
      },
      {
        "group": "Reference",
        "pages": [
          "cli",
          "mcp",
          "api"
        ]
      },
      {
        "group": "API playground",
        "openapi": "api-reference/openapi.json"
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Book a demo",
          "href": "mailto:sales@breachlens.app?subject=BreachLens%20live%20demo",
          "icon": "play"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:sales@breachlens.app"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get a license",
      "href": "mailto:sales@breachlens.app?subject=BreachLens%20license%20request"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  }
}
