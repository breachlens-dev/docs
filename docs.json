{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "BreachLens",
  "description": "Self-hosted application security — 9 scanner tiers, multi-AI auto-fix, and cross-tier attack-path correlation, all inside your own network.",
  "colors": {
    "primary": "#1D4ED8",
    "light": "#2563EB",
    "dark": "#1E40AF"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "pages": [
      {
        "group": "Getting started",
        "pages": [
          "index",
          "quickstart"
        ]
      },
      {
        "group": "Deployment",
        "pages": [
          "deployment/architecture",
          "deployment/air-gap",
          "deployment/licensing",
          "deployment/operations",
          "deployment/auth",
          "deployment/identity-architecture",
          "deployment/break-glass"
        ]
      },
      {
        "group": "Scanning",
        "pages": [
          "scanning/repositories",
          "scanning/github-posture",
          "scanning/cloud",
          "scanning/containers",
          "scanning/domains",
          "scanning/kubernetes"
        ]
      },
      {
        "group": "AI & identity",
        "pages": [
          "ai-providers",
          "ai-identity/identities",
          "ai-identity/ai-agents",
          "ai-identity/mcp-servers"
        ]
      },
      {
        "group": "Pipeline & monitoring",
        "pages": [
          "pipeline/cicd",
          "pipeline/continuous-monitoring",
          "pipeline/runtime"
        ]
      },
      {
        "group": "IDE",
        "pages": [
          "ide/vscode"
        ]
      },
      {
        "group": "Reference",
        "pages": [
          "cli",
          "api",
          "mcp"
        ]
      },
      {
        "group": "API playground (scans)",
        "openapi": "api-reference/openapi.json"
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Book a demo",
          "href": "mailto:sales@breachlens.app?subject=BreachLens%20live%20demo",
          "icon": "play"
        }
      ]
    }
  },
  "redirects": [
    { "source": "/auth", "destination": "/deployment/auth" },
    { "source": "/auth/sso", "destination": "/deployment/auth" },
    { "source": "/ai/providers", "destination": "/ai-providers" },
    { "source": "/deployment/airgap", "destination": "/deployment/air-gap" },
    { "source": "/security/license", "destination": "/deployment/licensing" }
  ],
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:sales@breachlens.app"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get a license",
      "href": "mailto:sales@breachlens.app?subject=BreachLens%20license%20request"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  }
}
